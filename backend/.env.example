CHAIN_PROVIDER=near

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# PEM private key for GitHub App (multi-line â€” wrap in quotes or use base64)
GITHUB_APP_PRIVATE_KEY=
