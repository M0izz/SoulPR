GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/auth/github/callback
FRONTEND_URL=http://localhost:5173
# Comma-separated additional exact origins allowed to call the API with cookies.
CORS_ALLOWED_ORIGINS=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# GitHub App installation settings; repository list is a comma-separated owner/repo catalog.
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_REPOSITORIES=
GITHUB_APP_ADMIN_USERNAME=
# PEM private key for GitHub App (multi-line — wrap in quotes or use base64)
GITHUB_APP_PRIVATE_KEY=
# Backend minter wallet private key — set this in Render's encrypted env var dashboard, NOT here
BACKEND_WALLET_PRIVATE_KEY=
# Firebase service account JSON (stringify the JSON into a single line)
FIREBASE_SERVICE_ACCOUNT_JSON=
# From contract/deployments/monad-testnet.json after deployment
CONTRACT_ADDRESS=
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Random 32+ char string for signing session cookies
SESSION_SECRET=
PORT=3001
