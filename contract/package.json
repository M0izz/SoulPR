{
  "name": "receipt-contract",
  "version": "1.0.0",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network monadTestnet",
    "near:build": "cargo build --manifest-path near/Cargo.toml --target wasm32-unknown-unknown --release",
    "near:test": "cargo test --manifest-path near/Cargo.toml",
    "near:deploy:testnet": "near deploy --accountId $NEAR_CONTRACT_ID --wasmFile near/target/wasm32-unknown-unknown/release/soulpr_near.wasm"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.19.0",
    "dotenv": "^16.3.1",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0"
  }
}
